# Postgres do hub (autorização local) e do db_inhaus (indicadores).
DATABASE_URL=postgresql://usuario:senha@host:5432/db_inhaus
DATABASE_URL_INHAUS=postgresql://usuario:senha@host:5432/db_inhaus

# global_auth (provedor de identidade). Valores reais só no .env.local (nunca aqui).
AUTH_BASE_URL=http://host:55321
AUTH_API_KEY=

AUTH_ACCESS_COOKIE_MAX_AGE_SECONDS=43200
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=7776000

# Admin(s) bootstrap — sempre entram como admin. Separe por vírgula.
BOOTSTRAP_ADMIN_EMAILS=

# Módulo de EPI: segredo do HMAC do CPF (identidade do colaborador). Gere um valor
# aleatório forte, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
# Trocar este segredo invalida os hashes de CPF já gravados.
EPI_CPF_SECRET=
